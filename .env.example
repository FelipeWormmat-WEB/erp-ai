APP_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://erp_user:replace-with-database-password@postgres:5432/erp
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.2
JWT_SECRET=senha forte jwt
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SEED_USERNAME=admin
SEED_PASSWORD=senha
POSTGRES_DB=erp
POSTGRES_USER=user
POSTGRES_PASSWORD=senah
